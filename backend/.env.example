# Server Port
PORT=5001
NODE_ENV=development

# Exact trusted frontend origins (comma-separated); required for production writes.
FRONTEND_URL=http://localhost:3000,http://localhost:3001

# Neon Serverless Postgres Connection String
# Get your connection string from https://console.neon.tech
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Optional direct connection for Drizzle migrations. The config also removes
# the pooler suffix from DATABASE_URL when this is absent.
# DATABASE_URL_UNPOOLED=postgresql://neondb_owner:YOUR_PASSWORD@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require

# Polar.sh Merchant of Record (Sandbox vs Production)
POLAR_SERVER=sandbox
POLAR_ACCESS_TOKEN=polar_oat_your_sandbox_access_token
POLAR_WEBHOOK_SECRET=polar_whsec_your_webhook_secret

# Polar Sandbox Product IDs
POLAR_PRODUCT_CREATOR_MONTHLY=your_creator_monthly_product_id
POLAR_PRODUCT_CREATOR_YEARLY=your_creator_yearly_product_id
POLAR_PRODUCT_EVENT_PASS=your_event_pass_product_id
