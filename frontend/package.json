    "db:migrate": "drizzle-kit migrate --config src/server/drizzle.config.ts",
    "test:api": "node --test tests/api.test.mjs",
    "test:auth": "node --test tests/auth-guardrails.test.mjs",
    "test:library": "node --test tests/library.test.mjs",
    "test:motion": "node --test tests/motion-export.test.mjs",
    "test:serverless": "node --import tsx --test tests/serverless-inprocess.test.mjs",
    "test": "node --test tests/api.test.mjs tests/auth-guardrails.test.mjs tests/library.test.mjs tests/motion-export.test.mjs && node --import tsx --test tests/serverless-inprocess.test.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.1.0",
    "@neondatabase/serverless": "^0.10.4",
    "@polar-sh/sdk": "^1.0.2",
    "@vercel/analytics": "^2.0.1",
    "canvas-confetti": "^1.9.4",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.3",
    "express": "^4.22.3",
    "lucide-react": "^1.52.0",
    "mediabunny": "1.61.3",
    "modern-gif": "2.1.0",
    "nanoid": "^5.1.16",
    "next": "16.3.8",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
