# Pho2Booth Frontend Configuration
BACKEND_INTERNAL_URL=http://127.0.0.1:5001
# Use the same exact origin list as the backend. Production requires HTTPS.
FRONTEND_URL=http://localhost:3000,http://localhost:3001

# Polar.sh Merchant of Record (Sandbox vs Production)
POLAR_SERVER=sandbox
POLAR_ACCESS_TOKEN=polar_oat_your_sandbox_access_token
POLAR_WEBHOOK_SECRET=polar_whsec_your_webhook_secret

# Polar Sandbox Product IDs
POLAR_PRODUCT_CREATOR_MONTHLY=your_creator_monthly_product_id
POLAR_PRODUCT_CREATOR_YEARLY=your_creator_yearly_product_id
POLAR_PRODUCT_EVENT_PASS=your_event_pass_product_id
